{
	"name": "openlsp-cli",
	"version": "0.1.0",
	"private": true,
	"description": "Bun-native, Zod-validated CLI for coding-agent language intelligence",
	"type": "module",
	"scripts": {
		"dev": "bun run src/cli.ts",
		"build": "bun build ./src/cli.ts --compile --outfile ./dist/openlsp-cli && bun run ./scripts/copy-assets.ts",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test",
		"livetest": "bun test tests/*.live.test.ts",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@vscode/tree-sitter-wasm": "^0.3.1",
		"vscode-languageserver-protocol": "^3.17.5",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"typescript": "^5.9.3"
	}
}
